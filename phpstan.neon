includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 3
  ignoreErrors:
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$name#'